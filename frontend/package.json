{
  "name": "relationer-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "api:generate": "node scripts/generate-api.mjs",
    "predev": "npm run api:generate",
    "dev": "vite --host 127.0.0.1",
    "pretypecheck": "npm run api:generate",
    "typecheck": "vue-tsc --noEmit",
    "pretest": "npm run api:generate",
    "test": "vitest run",
    "prebuild": "npm run api:generate",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "vue": "3.5.45",
    "@vue-flow/core": "1.48.2",
    "@vue-flow/background": "1.3.2",
    "@vue-flow/controls": "1.1.3",
    "@dagrejs/dagre": "3.1.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.1",
    "vite": "7.3.7",
    "typescript": "5.9.3",
    "vue-tsc": "3.1.1",
    "vitest": "5.1.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.10"
  }
}
